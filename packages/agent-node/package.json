    "@00/shared": "workspace:*",
    "buffer": "^6.0.3",
    "esbuild-wasm": "0.25.9",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "readable-stream": "^4.7.0",
    "semver": "^7.7.2",
    "string_decoder": "^1.3.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/path-browserify": "^1.0.3",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
