# Keep the store inside the repo so the self-contained toolchain stays tidy.
# Hoisting: allow pi packages to resolve their peer deps cleanly.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# `pnpm run <script>` must NEVER chain an install. pnpm 11's pre-run dependency check decides, under
# NODE_ENV=production, that the workspace's dev deps do not belong — and chains
# `pnpm install --production`, which begins by REMOVING node_modules. Reproduced 2026-08-30 with
# `NODE_ENV=production pnpm build`; only the no-TTY confirmation aborted the purge, and agents and CI
# are exactly the callers with no TTY (CI=true would have let it proceed). On this machine a purged
# node_modules is not an inconvenience but an incident — a duplicated reinstall once filled the disk
# and broke colima. Scripts run against whatever is installed; installing is its own deliberate act.
verify-deps-before-run=false
