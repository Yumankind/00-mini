{
  // The Homebrew wrangler serves this one; there is no node_modules here, so the schema is fetched.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "infinite-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",

  // No custom domain yet — the workers.dev URL is what the snippet points at until the hostname is
  // decided (docs/HANDOFF-infinite-agent.md §12). Adding a route later changes nothing else here.
  "workers_dev": true,
  "observability": { "enabled": true },

  // ONE binding, and it holds no state of ours. Phases 0–2 still need no backend (§9.1): the loader
  // and the PWA are static files, the crawl and the index live in the visitor's browser, and the
  // owner's settings come from the owner's own site. D1 and KV arrive with registration in Phase 3,
  // or in a second Worker (§9.4) — not here.
  //
  // MODELS is READ-ONLY USE of the public download bucket (`00-downloads`, also served as
  // dl.0-0.chat): MediaPipe's wasm under mediapipe/genai/<version>/wasm/ and the LiteRT weights
  // under litert/, both published by scripts/publish-litert-models.sh (§12.7). The Worker only ever
  // calls head() and get() on it. It is here because each wasm binary is ~27 MB and Cloudflare caps
  // a static asset at 25 MiB, and because same-origin is what lets the PWA's service worker keep
  // the runtime for offline (§4.4) — see src/index.ts and README.md.
  "r2_buckets": [{ "binding": "MODELS", "bucket_name": "00-downloads" }],

  //
  // "none" matters, and for the same reason it matters in apps/skills-site: with SPA or 404-page
  // handling the asset layer would answer /e/<ref>.js with index.html before the Worker ever ran,
  // and every embed on the web would load an HTML page as a script. "none" falls through to the
  // Worker for anything that is not a real file, and src/index.ts decides.
  // "run_worker_first" is new here and it is what makes cross-origin isolation possible at all.
  // By default the asset layer answers a request that matches a real file WITHOUT invoking the
  // Worker — so `/` (index.html) and `/sw.js` would go out with no
  // `Cross-Origin-Opener-Policy` / `Cross-Origin-Embedder-Policy`, the page would not be
  // `crossOriginIsolated`, and `SharedArrayBuffer` would not exist in it. Those two headers can only
  // come from code, so the code has to run. src/headers.ts then decides per route, and the cost is
  // one Worker invocation per asset — the price of a synchronous filesystem in the power shell.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
