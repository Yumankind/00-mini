# deps
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
*.dmg

# logs
*.log
npm-debug.log*

# env / secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Xcode
app-swift/**/xcuserdata/
app-swift/**/*.xcuserstate
app-swift/**/DerivedData/
app-swift/build/

# packaged sidecar (generated by app-swift/Scripts/build-sidecar.sh — see docs/native-app.md)
app-swift/Sidecar/

# 00 runtime data (never commit agent data / secrets)
/.run/
dist-headless/
# Wrangler's local state (the dev simulator's R2/D1/KV, build caches) — anywhere in the repo.
.wrangler/
# site-kit's shared assets are COPIED into each site's public/ at build time (npm run sync) — the
# source lives in apps/site-kit, and a tracked copy is just a second place to edit by mistake.
apps/skills-site/public/site.css
apps/skills-site/public/logo.js
apps/models-site/public/site.css
apps/models-site/public/logo.js
# The hosted meeting recorder is BUILT from packages/web-vue (one source, two servings) — its public/
# is vite output, so committing it would create a second, drifting copy of the capture page.
apps/meeting-site/public/

# Coverage output — rewritten by every `COVERAGE=1 vitest run` (CI ratchets thresholds on it);
# a tracked copy is pure diff noise.
apps/00d/coverage/
packages/web-vue/coverage/

# Catalog signing keys — private halves, never committed.
.00-catalog-keys/

# Generated store samples. The RAW generations (100 MB+) and the newly-added local-model set belong
# on R2, not in git. The remote-model out/ set was already tracked before this rule existed, so it is
# left alone rather than half-ignored — untracking it is a separate decision.
marketing/gen/**/raw/
marketing/gen/local-samples/

# dev-only video editor harness (local preview, not part of the feature)
packages/web-vue/timeline-harness.html
packages/web-vue/src/timeline-harness.ts

# skills.0-0.chat — deploys independently, installed with npm (see pnpm-workspace.yaml)
apps/models-site/node_modules/
# the video editor's per-render Remotion bundle — rebuilt and removed on every render
apps/00d/skills-store/video-editor/render/.bundle/

# `npm test` in apps/models-site compiles the TypeScript into here and runs node's own test runner
# over the output — this app has no bundler and no test framework, so the build output is transient.
apps/models-site/.test-build/
